{
  "name": "pogoraidbot",
  "version": "1.0.0",
  "description": "Bot Telegram per organizzare raid di Pokemon GO",
  "main": "bot.js",
  "type": "module",
  "scripts": {
    "start-sd": "node ScrapedDuck/ScrapedDuck-mio.js",
    "start": "cross-env NODE_ENV=production node src/bot.js",
    "dev": "cross-env NODE_ENV=development nodemon src/bot.js",
    "watch": "cross-env NODE_ENV=development node --watch src/bot.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "pokemon",
    "raid"
  ],
  "author": "Alessandro Mamolo",
  "license": "MIT",
  "dependencies": {
    "cross-env": "*",
    "csv-parse": "*",
    "dotenv": "*",
    "grammy": "^1.45.1",
    "node-fetch": "*",
    "scrapedduck": "github:bigfoott/ScrapedDuck"
  },
  "devDependencies": {
    "nodemon": "*"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  }
}
